# Copy this file to .env and fill in the values

# ========================================
# Security Settings (REQUIRED)
# ========================================

# JWT Secret Key - Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-use-random-32-bytes

# Flask Secret Key - Generate with: openssl rand -hex 32
FLASK_SECRET_KEY=another-secret-key-for-flask-sessions


# ========================================
# LLM Server Configuration
# ========================================

# LLM Server URL (running on host via start_ai.sh)
# Use host.docker.internal to access host machine from Docker
LLM_SERVER_URL=http://host.docker.internal:8080/v1/chat/completions


# ========================================
# CORS Configuration
# ========================================

# Comma-separated list of allowed origins (used for OpenEMIS domains)
# Localhost with ANY port is allowed by default via regex
CORS_ORIGINS=https://demo.openemis.org,https://*.openemis.org

# CORS Regex - allows localhost/127.0.0.1 with any port (optional)
# Default: ^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$


# ========================================
# Redis Configuration
# ========================================

# Redis connection URL
REDIS_URL=redis://redis:6379


# ========================================
# Application Settings
# ========================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Data and logs directories
DATA_DIR=/app/data
LOGS_DIR=/app/logs


# ========================================
# Development Settings
# ========================================

# Set to True for development mode
# DEBUG=False

# Host and port (usually don't need to change)
# HOST=0.0.0.0
# PORT=8000
