{
  "manifest_version": 3,
  "name": "AI Assistant",
  "version": "1.0",
  "description": "A simple AI assistant Chrome extension.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "host_permissions": [
    "http://localhost:8000/"
  ]
}
